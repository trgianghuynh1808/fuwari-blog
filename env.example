# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Get these values from your Supabase project dashboard

PUBLIC_SUPABASE_URL=your_supabase_project_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site domain (change this when the domain changes)
SITE_URL=https://blog.eridev.asia/

# GitHub (build-time sync of pinned repos on the About page)
# Token needs no scopes (public data only)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=trgianghuynh1808
